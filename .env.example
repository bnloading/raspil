# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Firebase web config (from Firebase Console > Project Settings > Web App) ---
# Not secret — access is controlled by firestore.rules — but kept in env vars per convention.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Seed script only (scripts/seed.mjs), never used by the browser app ---
# Path to a Firebase service-account JSON key (Project Settings > Service Accounts > Generate key).
# Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Dev seed accounts — one per role. Change these before running against a real project.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@ceh.kz
SEED_ADMIN_PASSWORD=change-me-123

SEED_MANAGER_NAME=Manager
SEED_MANAGER_EMAIL=manager@ceh.kz
SEED_MANAGER_PASSWORD=change-me-123

SEED_CUTTER_NAME=Cutter Worker
SEED_CUTTER_EMAIL=cutter@ceh.kz
SEED_CUTTER_PASSWORD=change-me-123

SEED_PVC_NAME=PVC Worker
SEED_PVC_EMAIL=pvc@ceh.kz
SEED_PVC_PASSWORD=change-me-123

SEED_CUSTOMER_NAME=Test Client
SEED_CUSTOMER_PHONE=+77771234567
SEED_CUSTOMER_PASSWORD=change-me-123
